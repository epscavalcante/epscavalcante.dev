---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('pt-BR', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(post.data.date);
---

<Layout title={`${post.data.title} | Eduardo Cavalcante`} description={post.data.description}>
  <article class="space-y-6">
    <a href="/posts" class="text-sm font-medium text-action hover:text-action-hover underline underline-offset-4">← Todos os posts</a>
    <header class="space-y-3">
      <time datetime={post.data.date.toISOString()} class="text-sm text-subtle">{date}</time>
      <h1 class="text-3xl font-bold">{post.data.title}</h1>
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>
