---
import PostList from './PostList.astro';
---

<section id="posts" aria-labelledby="posts-title" class="space-y-4 scroll-mt-6">
  <div class="flex items-center justify-between gap-4">
    <h2 id="posts-title" class="text-2xl font-bold">Posts</h2>
    <a href="/posts" class="text-sm font-medium text-action hover:text-action-hover underline underline-offset-4">Ver todos</a>
  </div>
  <PostList limit={3} />
</section>
