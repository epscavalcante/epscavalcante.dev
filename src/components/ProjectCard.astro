---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<a href={`/projetos/${project.id}`} class="block rounded-2xl border border-stroke bg-panel p-5 space-y-3 hover:border-action transition-colors">
  <h3 class="text-xl font-semibold">{project.data.title}</h3>
  <p class="text-muted">{project.data.description}</p>
  {project.data.technologies.length > 0 && (
    <ul aria-label="Tecnologias utilizadas" class="flex flex-wrap gap-2">
      {project.data.technologies.map((technology) => (
        <li class="rounded-field border border-stroke px-2 py-1 text-xs text-subtle">{technology}</li>
      ))}
    </ul>
  )}
  <span class="block text-sm font-medium text-action">Conhecer projeto →</span>
</a>
