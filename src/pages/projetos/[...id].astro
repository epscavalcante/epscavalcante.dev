---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Eduardo Cavalcante`} description={project.data.description}>
  <article class="space-y-6">
    <a href="/projetos" class="text-sm font-medium text-action hover:text-action-hover underline underline-offset-4">← Todos os projetos</a>
    <header class="space-y-3">
      <h1 class="text-3xl font-bold">{project.data.title}</h1>
      <p class="text-muted">{project.data.description}</p>
      {project.data.technologies.length > 0 && (
        <ul aria-label="Tecnologias utilizadas" class="flex flex-wrap gap-2">
          {project.data.technologies.map((technology) => (
            <li class="rounded-field border border-stroke px-2 py-1 text-xs text-subtle">{technology}</li>
          ))}
        </ul>
      )}
    </header>
    <div class="post-content">
      <Content />
    </div>
    {project.data.links.length > 0 && (
      <section aria-labelledby="project-links-title" class="space-y-4 border-t border-stroke pt-6">
        <h2 id="project-links-title" class="text-xl font-semibold">Acessar o projeto</h2>
        <ul class="flex flex-wrap gap-3">
          {project.data.links.map((link, index) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex rounded-lg px-4 py-2 text-sm font-medium transition-colors',
                  index === 0
                    ? 'bg-action text-on-action hover:bg-action-hover'
                    : 'border border-stroke bg-panel hover:bg-control',
                ]}
              >
                {link.label} ↗ <span class="sr-only">(abre em nova aba)</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
